{
  "name": "waverly",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives . && bun run --cwd apps/docs lint:docs",
    "lint:fix": "oxlint --fix --deny-warnings --report-unused-disable-directives .",
    "format": "oxfmt --write . && prettier --plugin=prettier-plugin-astro --write \"apps/**/*.astro\"",
    "format:check": "oxfmt --check . && prettier --plugin=prettier-plugin-astro --check \"apps/**/*.astro\"",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "lefthook": "^2.1.12",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "turbo": "^2.10.12"
  },
  "packageManager": "bun@1.3.10"
}
