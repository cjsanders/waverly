{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "waverly-docs",
  "account_id": "d464b0c0c3eb92aeb343cc1a2bb1c177",
  "main": "src/worker.ts",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-09-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/internal", "/internal/*", "/api/auth", "/api/auth/*"],
  },
}
