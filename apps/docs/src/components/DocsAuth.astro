---
interface Props {
  internalHref: string;
}

const { internalHref } = Astro.props;
---

<div class="flex items-center gap-1">
  <a
    href={internalHref}
    data-docs-when="signed-out"
    class="px-2 py-1 rounded-md text-[0.8125rem] font-medium no-underline text-muted-foreground hover:text-foreground hover:bg-accent/60 transition-colors"
  >
    Team
  </a>
  <a
    href="/api/auth/sign-out"
    data-docs-when="signed-in"
    hidden
    class="px-2 py-1 rounded-md text-[0.8125rem] font-medium no-underline text-muted-foreground hover:text-foreground hover:bg-accent/60 transition-colors"
  >
    Sign out
  </a>
</div>

<script>
  import "./docs-auth.client";
</script>
