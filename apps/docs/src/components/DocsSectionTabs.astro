---
import { isInternalPath } from "@/lib/docs-auth";

interface Section {
  label: string;
  href: string;
  isActive: boolean;
}

interface Props {
  sections: Section[];
}

const { sections } = Astro.props;
const publicSections = sections.filter(
  (section) => !isInternalPath(section.href),
);
const internalSection = sections.find((section) =>
  isInternalPath(section.href),
);
const linkClass = (active: boolean) => [
  "px-3 py-1 rounded-full text-sm font-semibold no-underline transition-colors shrink-0 whitespace-nowrap",
  active
    ? "text-primary-foreground bg-primary shadow-sm"
    : "text-muted-foreground hover:text-foreground hover:bg-background/50",
];
---

<div
  class="flex items-center gap-0.5 rounded-full bg-muted/80 p-0.5 ring-1 ring-border"
>
  {
    publicSections.map((section) => (
      <a
        href={section.href}
        aria-current={section.isActive ? "page" : undefined}
        class:list={linkClass(section.isActive)}
      >
        {section.label}
      </a>
    ))
  }
  {
    /* Hidden until signed-in. Hover prefetch only fires on visible links, so
       anonymous users do not prefetch /internal (404s or sign-in redirects).
       Do not set data-astro-prefetch="false" here: Astro binds hover listeners
       at load, and signed-in users need those once the tab is un-hidden. */
    internalSection && (
      <a
        href={internalSection.href}
        data-docs-when={internalSection.isActive ? undefined : "signed-in"}
        hidden={!internalSection.isActive}
        aria-current={internalSection.isActive ? "page" : undefined}
        class:list={linkClass(internalSection.isActive)}
      >
        {internalSection.label}
      </a>
    )
  }
</div>
