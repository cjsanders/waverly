---
import { config } from "virtual:nimbus/config";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout title={config.title} description={config.description}>
  <div class="flex min-h-screen flex-col">
    <Header />
    <main
      id="main-content"
      tabindex="-1"
      class="mx-auto w-full max-w-2xl flex-1 px-6 py-24"
    >
      <h1
        class="text-foreground leading-tight"
        style="font-size: var(--nb-h1-size); font-weight: var(--nb-h1-weight); letter-spacing: var(--nb-h1-tracking);"
      >
        {config.title}
      </h1>
      <p class="text-muted-foreground mt-2 text-[1.0625rem] leading-relaxed">
        {config.description}
      </p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <a
          href="/creators"
          class="border-border hover:border-border-strong bg-card block rounded-xl border p-6 no-underline transition-colors"
        >
          <div class="text-foreground font-medium">Creators</div>
          <div class="text-muted-foreground mt-0.5 text-sm">
            Share links, run collaborations, and get paid.
          </div>
        </a>
        <a
          href="/sellers"
          class="border-border hover:border-border-strong bg-card block rounded-xl border p-6 no-underline transition-colors"
        >
          <div class="text-foreground font-medium">Sellers</div>
          <div class="text-muted-foreground mt-0.5 text-sm">
            Run a brand program, recruit creators, and pay commissions.
          </div>
        </a>
      </div>
    </main>
  </div>
</BaseLayout>
