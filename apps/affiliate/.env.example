# Convex
# Convex deployment name
CONVEX_DEPLOYMENT=
# Convex deployment URL (required)
VITE_CONVEX_URL=

# WorkOS
# WorkOS client ID (required)
WORKOS_CLIENT_ID=
# WorkOS API key (required)
WORKOS_API_KEY=
# AuthKit callback URL (required)
WORKOS_REDIRECT_URI=https://affiliate.waverly.localhost/api/auth/callback
# Session cookie encryption password (at least 32 characters) (required)
WORKOS_COOKIE_PASSWORD=
# WorkOS API hostname
WORKOS_API_HOSTNAME=api.workos.com

# Tinybird (server only; use a token scoped to PIPE:READ)
TINYBIRD_API_URL=https://api.tinybird.co
TINYBIRD_PIPE_READ_TOKEN=

# Test user for agents, docs screenshots, and local tooling (dev only).
# Create this user in the WorkOS dashboard with Email + Password enabled.
# Never set these in production. Cloud Agent environments should inject them as secrets.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
