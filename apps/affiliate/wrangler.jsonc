{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "waverly-affiliate",
  "account_id": "d464b0c0c3eb92aeb343cc1a2bb1c177",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "secrets": {
    "required": [
      "WORKOS_CLIENT_ID",
      "WORKOS_API_KEY",
      "WORKOS_COOKIE_PASSWORD",
      "WORKOS_REDIRECT_URI",
    ],
  },
  // Local `vite dev` uses CLOUDFLARE_ENV=dev so the WorkOS test user is loaded
  // into the Worker. Production deploy stays on the top-level secrets list.
  "env": {
    "dev": {
      "vars": {
        "WORKOS_EMULATE": "false",
        "WORKOS_API_HOSTNAME": "api.workos.com",
        "WORKOS_API_HTTPS": "true",
        "WORKOS_API_PORT": "",
      },
      "secrets": {
        "required": [
          "WORKOS_CLIENT_ID",
          "WORKOS_API_KEY",
          "WORKOS_COOKIE_PASSWORD",
          "WORKOS_REDIRECT_URI",
          "TEST_USER_EMAIL",
          "TEST_USER_PASSWORD",
        ],
      },
    },
  },
  "observability": {
    "enabled": true,
  },
}
