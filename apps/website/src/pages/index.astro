---
import "../styles/global.css";
import Logo from "@waverly/design-system/astro/Logo.astro";
import favicon from "@waverly/design-system/brand/waverly-icon.svg?url";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Waverly connects brands and affiliates."
    />
    <title>Waverly</title>
  </head>
  <body class="grid min-h-screen place-items-center px-6">
    <main class="flex max-w-2xl flex-col items-center text-center">
      <Logo height={36} />
      <h1 class="mt-10 text-5xl font-semibold sm:text-7xl">
        Affiliate partnerships, made clear.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-8 text-muted-foreground">
        The public website is ready for your product story.
      </p>
      <a
        href="https://affiliate.waverly.localhost"
        class="mt-10 inline-flex h-12 items-center rounded-full bg-primary px-[26px] text-base font-medium text-primary-foreground transition-colors duration-150 ease-out hover:bg-brand-700 focus-visible:ring-[3px] focus-visible:ring-ring/30 focus-visible:outline-none dark:hover:bg-brand-400"
      >
        Open the workspace
      </a>
    </main>
  </body>
</html>
